@Metadata.layer: #CORE
@UI.headerInfo: {
    typeName: 'Travel',
    typeNamePlural: 'Travels',
    title :{ value: 'TravelId' } ,
    description : {  value: '_customer.FirstName' }
}
annotate view ZATS_SH_TRAVEL_Approver with
{

  @UI.facet: [
               { purpose           : #HEADER,
                 label             : 'Flight Ticket Price',
                 type              : #DATAPOINT_REFERENCE,
                 position          : 10,
                 targetQualifier   : 'Price_Data'  },
               { purpose           : #HEADER,
                 label             : 'Status',
                 type              : #DATAPOINT_REFERENCE,
                 position          : 20,
                 targetQualifier   : 'Status'  },
  --------------------------"Collection"--------------------------
               { purpose           : #STANDARD,
                 label             : 'Additional Details',
                 type              : #COLLECTION,
                 position          : 10,
                 id                : 'Super'   },
  --------------------------"Identification(Should only be one):Should be Under Collection"--------------------------
               { purpose           : #STANDARD,
                 label             : 'More Info',
                 type              : #IDENTIFICATION_REFERENCE,
                 position          : 10,
                 parentId          : 'Super'  },
  --------------------------"FieldGroup(Price Data):Should be under Collection"--------------------------
               { purpose           : #STANDARD,
                 label             : 'Price Data',
                 type              : #FIELDGROUP_REFERENCE,
                 position          : 20,
                 parentId          : 'Super',
                 targetQualifier   : 'Pricing'  },
  --------------------------"FieldGroup(Date(s)):Should be under Collection"--------------------------
               { purpose           : #STANDARD,
                 label             : 'Dates',
                 type              : #FIELDGROUP_REFERENCE,
                 position          : 30,
                 parentId          : 'Super',
                 targetQualifier   : 'Dates'  },
  //  --------------------------"FieldGroup(Admin Data):Should be under Collection"--------------------------
  //               { purpose           : #STANDARD,
  //                 label             : 'Admin Data',
  //                 type              : #FIELDGROUP_REFERENCE,
  //                 position          : 40,
  //                 parentId          : 'Super',
  //                 targetQualifier   : 'Admin'  }
  ----------------------------"Other Tab--------------------------"
              { purpose              : #STANDARD,
                type                 : #LINEITEM_REFERENCE,
                label                : 'Bookings',
                position             : 20,
                targetElement        : '_Booking'
                }
             ]
  @UI.selectionField  : [{ position   : 10 }]
  @UI.lineItem        : [{ position   : 10 }]

  @UI.identification  : [{ position : 10 }]
  TravelId;
  @UI.selectionField  : [{ position : 20 }]
  @UI.lineItem        : [{ position : 20 }]
  @UI.identification  : [{ position : 20 }]
  AgencyId;
  @UI.selectionField  : [{ position : 30 }]
  @UI.lineItem        : [{ position : 30 }]
  @UI.identification  : [{ position : 30 }]
  CustomerId;
  @UI.selectionField  : [{ position : 40 }]
  @UI.lineItem        : [{ position : 40 }]
  @UI.fieldGroup      : [{ qualifier : 'Dates'      ,
                            label    : 'Start Date' ,
                            position : 10 }]
  BeginDate;
  @UI.fieldGroup      : [{ qualifier : 'Dates'      ,
                            label    : 'End Date'   ,
                            position : 20 }]
  EndDate;
  @UI.fieldGroup      : [{ qualifier : 'Pricing' ,
                           label     : 'Booking Fee(s)' ,
                           position  : 10 }]
  BookingFee;
  @UI.selectionField  : [{ position : 50 }]
  @UI.lineItem        : [{ position :  50 }]
  @UI.dataPoint       :  { qualifier: 'Price_Data' ,
                           title    : 'Flight Price'
                        }
  @UI.fieldGroup      : [{ qualifier : 'Pricing'     ,
                           label     : 'Total Price' ,
                           position  : 20 }]
  TotalPrice;
  @UI.fieldGroup       : [{ qualifier : 'Pricing'  ,
                            label     : 'Currency' ,
                            position  : 30 }]
  CurrencyCode;
  //  Description;
  @UI.selectionField  : [{ position    : 50 }]
  @UI.lineItem        : [{ position    :  70           ,
                           criticality : 'Criticality' ,
                           importance  : #HIGH        },
                          { type       :#FOR_ACTION    ,
                            label      : 'Approve'     ,
                            dataAction : 'acceptTravel' },
                          { type       :#FOR_ACTION    ,
                            label      : 'Reject'     ,
                            dataAction : 'rejectTravel' }
                          
                        ]
  @UI.identification  : [{ type: #FOR_ACTION , label: 'Approve' , dataAction: 'acceptTravel'  },
                         { type: #FOR_ACTION , label: 'Reject'  , dataAction: 'rejectTravel'  }]          
  @UI.dataPoint       : { qualifier    : 'Status'        ,
                          title        : 'Travel Status' ,
                          criticality  : 'Criticality'
                        }
  @UI.fieldGroup      : [{ qualifier : 'Dates'      ,
                            label    : 'Status'     ,
                            position : 30 }]
  OverallStatus;



}