  expose /DMO/I_Overall_Status_VH;
  expose /DMO/I_Carrier;
  expose /DMO/I_Connection;
  expose /DMO/I_Booking_Status_VH;
  expose /DMO/I_Supplement;
  expose /DMO/I_SupplementText;
}