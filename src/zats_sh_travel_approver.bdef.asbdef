projection;
strict ( 2 );
use draft;

define behavior for ZATS_SH_TRAVEL_APPROVER alias Travel
{
  //use create;
  use update;
  //use delete;

  field (readonly) travelId , AgencyId , BeginDate ,
                      CreatedAt , CreatedBy , Criticality ,
                      CustomerId ,  Description , EndDate , TotalPrice;

  use action acceptTravel;
  use action rejectTravel;

  use action Prepare;
  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;

  use association _Booking {  with draft; }
}

define behavior for ZATS_SH_BOOKING_APPROVER alias Booking
{
 // use update;
  //use delete;

  use association _travel { with draft; }
}